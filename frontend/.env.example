# 프론트엔드 환경변수 (ARCHITECTURE.md §5 정합)
#
# VITE_API_BASE: API 요청 앞에 붙는 접두사.
#   client.js가 이미 '/api/...' 전체 경로를 쓰고 vite dev 서버가 /api -> localhost:3001로
#   프록시하므로 로컬 개발에서는 **비워 둬야 한다**. '/api'를 넣으면 '/api/api/assets'가 되어
#   전부 404가 난다. 프론트를 API와 다른 호스트에 배포할 때만 'https://api.example.com' 형태로 쓴다.
VITE_API_BASE=

# VITE_USE_MOCK: true면 백엔드 없이 mockApi(더미 데이터)로 동작한다.
#   실제 DB에 붙어 진짜 시세/뉴스를 보려면 false여야 한다. true인 채로 띄우면 차트에
#   가짜 가격이 뜨고, mock은 OHLC를 만들지 않아 주봉/월봉을 골라도 계속 라인으로 그려진다.
VITE_USE_MOCK=false
