# PostgreSQL 접속 (docker-compose 기본값)
DATABASE_URL=postgresql://admin:password@localhost:5432/antsurvival
PORT=3001
CORS_ORIGIN=http://localhost:5173

# 게임 시작일 선택 범위 (240거래일이 범위 안에 들어가도록 서버가 상한 보정)
GAME_START_RANGE=2014-01-02..2023-12-31

# 시드 데이터 원천 루트 (data-pipeline 체크아웃 위치 또는 Drive 다운로드 폴더)
DATA_DIR=/Users/hgs/Desktop/IISE-CD/data-pipeline

# Optional. Defaults to ../data/quant/signals.json from server root.
# QUANT_SIGNALS_FILE=/absolute/path/to/done/quant/version/model-v1/signals.json
# Alpha158 per-stock contributions. Folder must contain the exact pinned signals.json,
# spec.json, features.parquet and lgb-YYYYMMDD.txt checkpoints.
# Defaults to the signals folder, or its matching active-data.json model_directory.
# QUANT_MODEL_DIR=/absolute/path/to/quant/version/model-v4-adjusted-open
# QUANT_EXPLAIN_PYTHON=/absolute/path/to/quant/.venv/bin/python
# Uses USER_STRATEGY_PYTHON when unset. Needs LightGBM, pandas and pyarrow.

# User workshop RF/LightGBM training. Install quant/workshop-requirements.txt into this environment.
# Defaults to quant/.venv/bin/python if present, otherwise python3.
# USER_STRATEGY_PYTHON=/absolute/path/to/quant/.venv/bin/python
